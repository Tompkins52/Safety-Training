# Copy this file to .env and edit the values. Lines starting with # are comments.

# ---- Core -------------------------------------------------------------------
# Long random string used to sign sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-going-live
ORG_NAME=City Public Works Department
APP_NAME=Public Works Safety Training
# Public address of the site, used to build links in email notifications
APP_BASE_URL=http://localhost:5000
TIMEZONE=America/Chicago

# ---- Database ---------------------------------------------------------------
# Default is a SQLite file in ./instance/safety.db. For PostgreSQL use e.g.
# DATABASE_URL=postgresql+psycopg://user:password@dbhost/safety
# DATABASE_URL=sqlite:////absolute/path/to/safety.db

# ---- Training rules ---------------------------------------------------------
QUIZ_PASS_PERCENT=80
AUTO_RENEW_ASSIGNMENTS=true
DEFAULT_RENEWAL_MONTHS=12
DEFAULT_DUE_DAYS=30

# ---- Notification rules -----------------------------------------------------
REMINDER_DAYS_BEFORE_DUE=30
SECOND_REMINDER_DAYS_BEFORE_DUE=7
OVERDUE_REMINDER_EVERY_DAYS=7
NOTIFY_SUPERVISOR_ON_COMPLETION=true
NOTIFY_ON_INCIDENT=true

# ---- Email (SMTP) -----------------------------------------------------------
# Leave MAIL_ENABLED=false to run without an email server. Messages are then
# written to the notification log (Admin > Notifications) and the console.
MAIL_ENABLED=false
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=safety-training@example.gov
MAIL_PASSWORD=
MAIL_FROM=safety-training@example.gov
# Receives a copy of every incident report notice
SAFETY_OFFICER_EMAIL=

# ---- Scheduler --------------------------------------------------------------
# The built-in scheduler runs the daily notification job inside the web process.
# If you run more than one web worker, set this to false and run
#   flask run-notifications
# from cron once a day instead (see docs/deployment.md).
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=6
SCHEDULER_MINUTE=0
